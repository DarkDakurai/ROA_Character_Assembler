    {"$GMRAssetLayer":"","%Name":"Assets_1","assets":[
        {"$GMRTextItem":"v3","%Name":"text_7C155D23","alignment":0,"charSpacing":0.0,"colour":4278255419,"fontId":{"name":"fnt_jersey20_SDF","path":"fonts/fnt_jersey20_SDF/fnt_jersey20_SDF.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_7C155D23","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.66305393,"scaleY":0.66305393,"text":"Welcome to the Rivals Of Aether Character Assembler!","wrap":false,"x":135.0,"y":8.0,},
        {"$GMRTextItem":"v3","%Name":"text_4CD77A68","alignment":0,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"fnt_jersey20_SDF","path":"fonts/fnt_jersey20_SDF/fnt_jersey20_SDF.yy",},"frameH":1358.3627,"frameW":2660.7515,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_4CD77A68","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.48355168,"scaleY":0.48355168,"text":"Before you start using this program I'd like to clarify that I'm not associated with Aether Studios and do not own any of their assets.\r\n\r\nThis is a passion project to help make character creation quicker. This program is not intended to be used for complex characters, as custom AI and attacks are not fully implemented.\r\n\r\nIt was made by me, Davi (dvdX) with GameMaker. \r\nIf you find any bugs please report them on the following GitHub page:\r\n\r\n\r\nSpecial thanks to EquinoxDoodles, YoYo Games and Aether Studios.","wrap":true,"x":32.0,"y":96.0,},
